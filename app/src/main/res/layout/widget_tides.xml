<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#FFFFFFFF"/>

    <TextView
        android:id="@+id/date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="#CCFFFFFF"/>

    <LinearLayout
        android:id="@+id/row1"
        style="@style/TideRow">
        <TextView android:id="@+id/kind1" style="@style/TideKind"/>
        <TextView android:id="@+id/time1" style="@style/TideTime"/>
        <TextView android:id="@+id/detail1" style="@style/TideDetail"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row2"
        style="@style/TideRow">
        <TextView android:id="@+id/kind2" style="@style/TideKind"/>
        <TextView android:id="@+id/time2" style="@style/TideTime"/>
        <TextView android:id="@+id/detail2" style="@style/TideDetail"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row3"
        style="@style/TideRow">
        <TextView android:id="@+id/kind3" style="@style/TideKind"/>
        <TextView android:id="@+id/time3" style="@style/TideTime"/>
        <TextView android:id="@+id/detail3" style="@style/TideDetail"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row4"
        style="@style/TideRow">
        <TextView android:id="@+id/kind4" style="@style/TideKind"/>
        <TextView android:id="@+id/time4" style="@style/TideTime"/>
        <TextView android:id="@+id/detail4" style="@style/TideDetail"/>
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="9sp"
        android:textColor="#AAFFFFFF"/>

</LinearLayout>
